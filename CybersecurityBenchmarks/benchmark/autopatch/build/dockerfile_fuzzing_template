FROM docker.io/n132/arvo:{ARVO_ID}-fix

# Set environment variables to avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install Python 3.7, LLDB 13, and dependencies
COPY ./differential-debugging-deps-16.04.deb /tmp/differential-debugging-deps-16.04.deb
COPY ./differential-debugging-deps-20.04.deb /tmp/differential-debugging-deps-20.04.deb

RUN OSVER=$(cat /etc/os-release |grep VERSION_ID | cut -c13-17) && \
    case "$OSVER" in \
    "16.04") ln -s /tmp/differential-debugging-deps-16.04.deb /tmp/differential-debugging-deps.deb ;; \
    "20.04") ln -s /tmp/differential-debugging-deps-20.04.deb /tmp/differential-debugging-deps.deb && \
    apt update && \
    apt install -y --no-install-recommends libssl-dev \
    libexpat1-dev \
    libfreetype-dev  ;; \
    *) echo "Unknown OS VERSION: $OSVER" ;; \
    esac

RUN apt -f -y install /tmp/differential-debugging-deps.deb && echo '/usr/local/lib' > /etc/ld.so.conf.d/local.conf && ldconfig

# Install patchelf for fixing RPATH of rebuilt binaries
RUN apt-get update && apt-get install -y --no-install-recommends patchelf && rm -rf /var/lib/apt/lists/*

RUN rm /tmp/differential-debugging-deps.deb /tmp/differential-debugging-deps-20.04.deb /tmp/differential-debugging-deps-16.04.deb

# Install CASR (Crash Analysis and Severity Reporting) for crash deduplication
# Download with: ./download_casr.sh (run once on host before building containers)
#
# CASR requires glibc 2.25+, but containers have glibc 2.23. We install glibc 2.35
# to /opt/glibc-new/ and patch CASR binaries to use it via RPATH, avoiding
# conflicts with the system glibc.

# Install glibc 2.35 to /opt/glibc-new/ (separate from system glibc)
COPY ./libc6_2.35-0ubuntu3_amd64.deb /tmp/glibc.deb
RUN mkdir -p /opt/glibc-new && \
    dpkg-deb -x /tmp/glibc.deb /opt/glibc-new/ && \
    rm /tmp/glibc.deb

# Copy and patch CASR binaries (built from forked source) to use new glibc
COPY ./casr-binaries.tar.gz /tmp/casr.tar.gz
RUN mkdir -p /usr/local/casr && \
    tar -xzf /tmp/casr.tar.gz -C /usr/local/casr && \
    rm /tmp/casr.tar.gz && \
    # Patch each CASR binary to use the new glibc via RPATH and dynamic linker
    for tool in /usr/local/casr/bin/casr-*; do \
    # Set RPATH to find new glibc libraries
    patchelf --set-rpath /opt/glibc-new/lib/x86_64-linux-gnu "$tool" && \
    # Set interpreter to use new dynamic linker
    patchelf --set-interpreter /opt/glibc-new/lib/x86_64-linux-gnu/ld-linux-x86-64.so.2 "$tool" && \
    echo "Patched $(basename $tool)"; \
    done && \
    # Create symlinks in /usr/bin for convenience
    ln -sf /usr/local/casr/bin/casr-afl /usr/bin/casr-afl && \
    ln -sf /usr/local/casr/bin/casr-cluster /usr/bin/casr-cluster && \
    ln -sf /usr/local/casr/bin/casr-cluster-map /usr/bin/casr-cluster-map && \
    ln -sf /usr/local/casr/bin/casr-libfuzzer /usr/bin/casr-libfuzzer && \
    ln -sf /usr/local/casr/bin/casr-san /usr/bin/casr-san && \
    ln -sf /usr/local/casr/bin/casr-gdb /usr/bin/casr-gdb && \
    ln -sf /usr/local/casr/bin/casr-compare /usr/bin/casr-compare

# Verify CASR installation
RUN casr-san --version && echo "CASR installed successfully with glibc 2.35 via RPATH"

# Configure LLDB
RUN echo "settings set target.disable-aslr false" > ~/.lldbinit && \
    echo "settings set target.inherit-env true" >> ~/.lldbinit && \
    echo "settings set target.process.thread.step-avoid-regexp ''" >> ~/.lldbinit

# Copy patched libfuzzer source (LLVM 10 with trace-pc-guard support re-added)
# This libfuzzer has:
# 1. Fork mode support (from LLVM 10) - enables -fork, -ignore_crashes, etc.
# 2. trace-pc-guard support (re-added from LLVM 8) - works with existing instrumentation
# 3. Per-crash log files for CASR (RedirectStderrToCrashLog) - avoids binary re-runs
# No need to change COVERAGE_FLAGS or rebuild project libraries!
#
# Two installation methods (both are applied):
# A) Replace source at /src/libfuzzer/ - OSS-Fuzz's compile_libfuzzer will compile it
# B) Build and replace clang runtime libraries (if they exist) - for direct linking
#
# IMPORTANT: We must delete old source first! Old files like FuzzerTraceState.cpp
# reference APIs from old headers that our modern headers don't have.
RUN rm -rf /src/libfuzzer/* 2>/dev/null || true
COPY ./libfuzzer-modern/ /src/libfuzzer/

# Build and install our modified libfuzzer
# Detection logic:
# - NEW compile_libfuzzer (uses -fsanitize=fuzzer): MUST replace system library
# - OLD compile_libfuzzer (compiles from source): source replacement works, library optional
# Note: 80% of cases use NEW, 20% use OLD (based on benchmark analysis)
RUN cd /src/libfuzzer && \
    chmod +x ./build.sh && \
    PROJECT_ARCH=$(grep -oP 'ARCHITECTURE=\K\w+' /bin/arvo 2>/dev/null || echo "x86_64") && \
    if [ "$PROJECT_ARCH" = "i386" ]; then FUZZER_ARCH="i386"; else FUZZER_ARCH="x86_64"; fi && \
    echo "Detected project architecture: $PROJECT_ARCH -> target: $FUZZER_ARCH" && \
    if grep -q 'fsanitize=fuzzer' /usr/local/bin/compile_libfuzzer 2>/dev/null; then \
    COMPILE_TYPE="NEW"; \
    echo "compile_libfuzzer type: NEW (uses -fsanitize=fuzzer, library replacement REQUIRED)"; \
    else \
    COMPILE_TYPE="OLD"; \
    echo "compile_libfuzzer type: OLD (compiles from /src/libfuzzer/, source method works)"; \
    fi && \
    FUZZER_LIB=$(find /usr/local/lib/clang -name "libclang_rt.fuzzer-${FUZZER_ARCH}.a" 2>/dev/null | head -1) && \
    if [ -n "$FUZZER_LIB" ]; then CLANG_LIB_DIR=$(dirname "$FUZZER_LIB"); else CLANG_LIB_DIR=""; fi && \
    if [ -n "$CLANG_LIB_DIR" ]; then \
    echo "=== Building and replacing system libfuzzer ===" && \
    ARCH=$FUZZER_ARCH ./build.sh && \
    echo "Replacing system libfuzzer at: $CLANG_LIB_DIR (arch: $FUZZER_ARCH)" && \
    cp libFuzzer.a "$CLANG_LIB_DIR/libclang_rt.fuzzer-${FUZZER_ARCH}.a" && \
    cp libFuzzer_no_main.a "$CLANG_LIB_DIR/libclang_rt.fuzzer_no_main-${FUZZER_ARCH}.a" && \
    echo "LIBRARY method: system libfuzzer replaced successfully"; \
    else \
    echo "=== No system libfuzzer found (clang $(/usr/local/bin/clang --version 2>/dev/null | head -1 || echo 'unknown')) ===" && \
    if [ "$COMPILE_TYPE" = "NEW" ]; then \
    echo "WARNING: NEW compile_libfuzzer but no system library to replace!"; \
    echo "Custom crash logging may not work for this case."; \
    fi && \
    echo "SOURCE method: using /src/libfuzzer/ (already installed)"; \
    fi && \
    if [ -f /usr/lib/libFuzzingEngine.a ]; then \
    echo "Also replacing /usr/lib/libFuzzingEngine.a" && \
    ARCH=$FUZZER_ARCH ./build.sh 2>/dev/null || true && \
    cp libFuzzer.a /usr/lib/libFuzzingEngine.a 2>/dev/null || true; \
    fi && \
    echo "Modified libFuzzer installed (source at /src/libfuzzer/)"

# Prepare /tmp/corpus and modify /bin/arvo for fuzzing
# Key differences from dockerfile_fix_template:
# 1. No -max_total_time in base FUZZER_ARGS (will be set at runtime)
# 2. No 10-minute QA fuzzing (RUN arvo run is removed)
RUN mkdir -p /tmp/corpus/ && \
    cp /tmp/poc /tmp/corpus/ && \
    chmod 755 /tmp/poc /tmp/corpus && \
    sed -i '0,/\/tmp\/poc/s//\/tmp\/corpus\//' /bin/arvo && \
    sed -i 's|export FUZZER_ARGS="-rss_limit_mb=2560 -timeout=25"|export FUZZER_ARGS="-rss_limit_mb=2560 -timeout=25"|' /bin/arvo && \
    sed -i 's|/tmp/corpus/|& $FUZZER_ARGS|' /bin/arvo && \
    sed -i '/\/tmp\/corpus\/ $FUZZER_ARGS/a elif [ "$first_param" = "fuzz_fix" ]; then' /bin/arvo && \
    sed -i '/fuzz_fix" ]; then/a    /tmp/rebuilt_binary /tmp/corpus/ $FUZZER_ARGS' /bin/arvo

# Provision files for differential debugging (kept for compatibility)
COPY ./microsnapshots/ /microsnapshots/

# QA: Assert that `arvo` exits with code 0 (basic sanity check)
RUN arvo

# Force rebuild of fuzzer binaries by deleting them
# This is necessary because cmake won't relink even if we replaced the fuzzer library
# The binaries were built in the base image before our modified library was installed
RUN find /out -maxdepth 1 -type f \( -name '*fuzz*' -o -name '*fuzzer*' \) -executable -delete 2>/dev/null || true && \
    echo "Deleted pre-built fuzzer binaries to force rebuild with our modified libfuzzer"

# Rebuild project including fuzzer binaries with our modified libfuzzer
# The project libraries keep their existing trace-pc-guard instrumentation
RUN arvo compile

# SKIPPED: "arvo run" (10 mins of fuzzing on GT patch) - we do this at runtime instead
# This is the key difference from dockerfile_fix_template

# QA: Assert that 2nd issuing of `arvo compile` exits with code 0
RUN arvo compile
