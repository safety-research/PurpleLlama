FROM {VUL_BASE_IMAGE}

# Set environment variables to avoid interactive prompts during package installation
ENV DEBIAN_FRONTEND=noninteractive

# Install precompiled namespace-isolated libfuzzer
# This libfuzzer has its own private libc++ in the __Fuzzer ABI namespace,
# matching LLVM's compiler-rt approach. This eliminates MSan false positives
# from uninstrumented libc++ symbol collisions.
#
# Features:
# 1. Fork mode support (from LLVM 10) - enables -fork, -ignore_crashes, etc.
# 2. trace-pc-guard support (re-added from LLVM 8) - works with existing instrumentation
# 3. Per-crash log files for CASR (RedirectStderrToCrashLog) - avoids binary re-runs
# 4. Namespace-isolated libc++ (__Fuzzer) - no MSan false positives
#
# Archives contain both x86_64 and i386 variants.
COPY ./libfuzzer-prebuilt/ /tmp/libfuzzer-prebuilt/

# Also copy source for compile_libfuzzer (OLD method, ~20% of cases compile from source)
RUN rm -rf /src/libfuzzer/* 2>/dev/null || true
COPY ./libfuzzer-modern/ /src/libfuzzer/

# Backport __msan_scoped_disable_interceptor_checks on old MSan runtimes
# (pre-rL336447, July 2018).  The bundled libc++ is uninstrumented, so MSan
# interceptors must be told to skip shadow checks for fuzzer-internal data.
# On LLVM 8+ this API exists natively; on older runtimes we patch it in by
# globalizing the existing in_interceptor_scope TLS counter and adding a shim.
COPY ./patch-msan-scoped-disable.sh /tmp/patch-msan-scoped-disable.sh
RUN chmod +x /tmp/patch-msan-scoped-disable.sh && /tmp/patch-msan-scoped-disable.sh && rm /tmp/patch-msan-scoped-disable.sh

# Install precompiled archives: replace system clang runtime + FuzzingEngine
RUN PROJECT_ARCH=$(grep -oP 'ARCHITECTURE=\K\w+' /bin/arvo 2>/dev/null || echo "x86_64") && \
    if [ "$PROJECT_ARCH" = "i386" ]; then FUZZER_SUFFIX="i386"; else FUZZER_SUFFIX="x86_64"; fi && \
    echo "Installing precompiled libfuzzer for ${FUZZER_SUFFIX}..." && \
    FUZZER_LIB=$(find /usr/local/lib/clang -name "libclang_rt.fuzzer-${FUZZER_SUFFIX}.a" 2>/dev/null | head -1) && \
    if [ -n "$FUZZER_LIB" ]; then \
        CLANG_LIB_DIR=$(dirname "$FUZZER_LIB") && \
        cp /tmp/libfuzzer-prebuilt/libFuzzer-${FUZZER_SUFFIX}.a "$CLANG_LIB_DIR/libclang_rt.fuzzer-${FUZZER_SUFFIX}.a" && \
        cp /tmp/libfuzzer-prebuilt/libFuzzer_no_main-${FUZZER_SUFFIX}.a "$CLANG_LIB_DIR/libclang_rt.fuzzer_no_main-${FUZZER_SUFFIX}.a" && \
        echo "Replaced system libfuzzer at: $CLANG_LIB_DIR"; \
    else \
        echo "No system libfuzzer found -- source method will be used"; \
    fi && \
    if [ -f /usr/lib/libFuzzingEngine.a ]; then \
        cp /tmp/libfuzzer-prebuilt/libFuzzer-${FUZZER_SUFFIX}.a /usr/lib/libFuzzingEngine.a && \
        echo "Replaced /usr/lib/libFuzzingEngine.a"; \
    fi && \
    rm -rf /tmp/libfuzzer-prebuilt/ && \
    echo "Precompiled libFuzzer installed"

# Prepare /tmp/corpus and modify /bin/arvo
RUN mkdir -p /tmp/corpus/ && \
    cp /tmp/poc /tmp/corpus/ && \
    chmod 755 /tmp/poc /tmp/corpus && \
    sed -i '0,/\/tmp\/poc/s//\/tmp\/corpus\//' /bin/arvo && \
    sed -i 's|export FUZZER_ARGS="-rss_limit_mb=2560 -timeout=25"|export FUZZER_ARGS="-rss_limit_mb=2560 -timeout=25 -max_total_time=60"|' /bin/arvo && \
    sed -i 's|/tmp/corpus/|& $FUZZER_ARGS|' /bin/arvo && \
    sed -i '/\/tmp\/corpus\/ $FUZZER_ARGS/a elif [ "$first_param" = "fuzz_fix" ]; then \\n    /tmp/rebuilt_binary /tmp/corpus/ $FUZZER_ARGS' /bin/arvo

# QA: Assert that `arvo` exits with non-zero code (crash should still occur)
RUN ! arvo

# Force rebuild of fuzzer binaries by deleting them
# This is necessary because cmake won't relink even if we replaced the fuzzer library
# The binaries were built in the base image before our modified library was installed
RUN find /out -maxdepth 1 -type f \( -name '*fuzz*' -o -name '*fuzzer*' \) -executable -delete 2>/dev/null || true && \
    echo "Deleted pre-built fuzzer binaries to force rebuild with our modified libfuzzer"

# Rebuild project including fuzzer binaries with our modified libfuzzer
# The project libraries keep their existing trace-pc-guard instrumentation
RUN arvo compile

# Some projects (e.g. freeradius) install fuzzer binaries to /usr/local/bin/
# via "make install" but fail to copy them back to /out/. Recover any missing
# binaries that the arvo script references.
RUN BINARY=$(sed -n 's|.*/out/\([^ ]*\).*|\1|p' /bin/arvo | head -1) && \
    if [ -n "$BINARY" ] && [ ! -f "/out/$BINARY" ] && [ -f "/usr/local/bin/$BINARY" ]; then \
        cp "/usr/local/bin/$BINARY" "/out/$BINARY" && \
        echo "Recovered /out/$BINARY from /usr/local/bin/"; \
    fi

# QA: Assert that `arvo compile` works for a second time
RUN arvo compile
